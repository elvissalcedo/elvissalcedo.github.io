# Jekyll build output y caché local -- nunca se comitea, GitHub Pages
# genera el sitio publicado por su cuenta a partir de _config.yml/_posts/etc.
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Bundler local (si se instalan las gemas dentro del repo en vez de global)
.bundle/
vendor/

# Bytecode que deja Python al importar los scripts del panel de control
# (panel_control.py importa publicar_articulo.py y validar_articulos.py).
# Se regenera solo; no tiene nada que hacer en el repo.
__pycache__/
*.pyc

# Documentos de trabajo con NotebookLM -- retirados del repo el 2026-09-22
# (decisión de Elvis), pero siguen existiendo en el disco como referencia
# personal fuera de control de versiones. Nunca se comitean ni se suben.
02-instrucciones-notebooklm.md
03-prompt-notebooklm.txt

